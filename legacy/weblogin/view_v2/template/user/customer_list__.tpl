<script>
$('#show-bill').on('show.bs.modal', function(e) {
	var id = ($(e.relatedTarget).data('id'));
	$('#section-printslip input[name=\'id\']').val(id);
});
$('#button-bill').click(function(){
	$.ajax({
		url: 'index.php?route=courier/shipping/generateslip&token=<?php echo $token; ?>',
		type: 'post',
		data: $('#section-printslip input[type=\'text\'], #section-printslip input[type=\'hidden\'], #section-printslip textarea'),
		dataType: 'json',
		beforeSend: function() {
			$('#button-printslip').button('loading');
		},
		complete: function() {
			 $('#button-printslip').button('reset');
		},
		success: function(json) {
			$('.alert, .text-danger').remove();
			if (json['error']) {
				$('#printslip-msg').prepend('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}
			
			if (json['success']) {
				$('#printslip-msg').prepend('<div class="alert alert-success"><i class="fa fa-check-circle"></i> ' + json['success'] + '  <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
				$('#footer-printslip').hide();
				setTimeout(function () {window.location.href = "index.php?route=courier/shipping&token=<?php echo $token; ?>"; }, 5000);
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
</script>
